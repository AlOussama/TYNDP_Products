{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IoSN ML-R03 illustrative synthetic contract fixture",
  "type": "object",
  "description": "Non-normative synthetic examples. Passing structural validation is not approval of any real IoSN data or methodology.",
  "required": [
    "schema_version",
    "mode",
    "study_years",
    "weather_cases",
    "releases",
    "runs",
    "data_instances",
    "transformations",
    "definitions",
    "transformation_spec_ids",
    "raw_outputs",
    "publishable",
    "gate_status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "MLR03-SYN-0.1"
    },
    "mode": {
      "enum": [
        "SYNTHETIC_TEST_ONLY",
        "PRODUCTION"
      ]
    },
    "purpose": {
      "type": "string"
    },
    "study_years": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          2035,
          2040,
          2050
        ]
      }
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "transformation_spec_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "weather_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "study_year",
          "case_id",
          "weight",
          "profile_ref"
        ],
        "properties": {
          "study_year": {
            "enum": [
              2035,
              2040,
              2050
            ]
          },
          "case_id": {
            "enum": [
              "CY1",
              "CY2",
              "CY3",
              "CY4",
              "CY5"
            ]
          },
          "weight": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "profile_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "release_id",
          "source_id",
          "qualification_status",
          "original_sha256"
        ],
        "properties": {
          "release_id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "qualification_status": {
            "type": "string"
          },
          "original_sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "study_year",
          "branch_type",
          "release_gate"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "study_year": {
            "enum": [
              2035,
              2040,
              2050
            ]
          },
          "branch_type": {
            "type": "string"
          },
          "release_gate": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "data_instances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "instance_id",
          "object_id",
          "role",
          "release_id",
          "run_id",
          "study_year",
          "case_id",
          "zone_id",
          "carrier",
          "series_key",
          "unit",
          "dimension",
          "start_utc",
          "end_utc",
          "value",
          "provenance"
        ],
        "properties": {
          "instance_id": {
            "type": "string"
          },
          "object_id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "SOURCE_INPUT",
              "INTERNAL_DERIVED"
            ]
          },
          "release_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "run_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "study_year": {
            "enum": [
              2035,
              2040,
              2050
            ]
          },
          "case_id": {
            "enum": [
              "CY1",
              "CY2",
              "CY3",
              "CY4",
              "CY5"
            ]
          },
          "zone_id": {
            "type": "string"
          },
          "carrier": {
            "type": "string"
          },
          "series_key": {
            "type": "string"
          },
          "unit": {
            "enum": [
              "MW",
              "GW",
              "MWh",
              "GWh",
              "kg_H2"
            ]
          },
          "dimension": {
            "enum": [
              "power",
              "energy",
              "mass"
            ]
          },
          "start_utc": {
            "type": "string",
            "pattern": "Z$"
          },
          "end_utc": {
            "type": "string",
            "pattern": "Z$"
          },
          "value": {
            "type": "number"
          },
          "provenance": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "source_instance_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "transformation_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "transformation_id",
          "spec_ref",
          "run_id",
          "input_instance_ids",
          "output_instance_ids",
          "test_only"
        ],
        "properties": {
          "transformation_id": {
            "type": "string"
          },
          "spec_ref": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "input_instance_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_instance_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test_only": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "raw_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "result_id",
          "run_id",
          "quantity_type",
          "unit",
          "value",
          "status"
        ],
        "properties": {
          "result_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "quantity_type": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "publishable": {
      "type": "boolean"
    },
    "gate_status": {
      "type": "string"
    }
  }
}
