{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical IoSN selected-weather manifest output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "study_year",
    "source_ref",
    "run_id",
    "dataset_id",
    "adapter_type",
    "scenarios"
  ],
  "properties": {
    "study_year": {
      "type": "integer"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter_type": {
      "enum": [
        "rows_v1",
        "map_v1"
      ]
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "weight"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number"
          }
        }
      }
    }
  }
}
