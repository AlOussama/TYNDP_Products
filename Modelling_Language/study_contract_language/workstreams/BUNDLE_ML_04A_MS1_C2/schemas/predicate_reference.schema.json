{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C2 outer qualified predicate reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "predicate_id",
    "role",
    "axes",
    "scope_id"
  ],
  "properties": {
    "predicate_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "PREDICATE",
        "GUARD",
        "DATA_ASSUMPTION"
      ]
    },
    "axes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "scope_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
