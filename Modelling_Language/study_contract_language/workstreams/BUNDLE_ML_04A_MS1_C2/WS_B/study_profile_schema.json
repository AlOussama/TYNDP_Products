{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2:study-profile",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "profile_identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "native_study_identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "data_context_identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "case_context_identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "owner": {
      "enum": [
        "OWNER_TBD"
      ]
    }
  },
  "required": [
    "id",
    "version",
    "profile_identity",
    "native_study_identity",
    "data_context_identity",
    "case_context_identity",
    "owner"
  ],
  "additionalProperties": false
}
