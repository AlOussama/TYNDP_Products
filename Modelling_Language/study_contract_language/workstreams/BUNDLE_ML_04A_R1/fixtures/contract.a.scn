contract "study:paired" schema "C20-research-r1" rules "CSNF-R0" registry "energy-r1" {
frame "study:paired" { question: "Finite synthetic paired observable study"; time: { id: "study:duration"; duration: "1"; duration_unit: "h"; }; domains: [{ id: "domain:scenario"; kind: "scenario"; members: ["s1", "s2"]; }, { id: "domain:period"; kind: "time"; members: ["t0", "t1"]; }]; scopes: [{ id: "scope:pair"; domains: ["domain:scenario", "domain:period"]; }]; guards: [{ id: "guard:available"; expr: { op: "bool3"; value: "TRUE"; }; }]; information_sets: [{ id: "info:initial"; time_domain: "domain:period"; stage: "t0"; scenario_domain: "domain:scenario"; partition: [["s1", "s2"]]; }, { id: "info:revealed"; time_domain: "domain:period"; stage: "t1"; scenario_domain: "domain:scenario"; partition: [["s1"], ["s2"]]; }]; data_inputs: [{ id: "input:probability"; role: "probability"; axes: ["domain:scenario"]; unit: "1"; basis: ""; }, { id: "input:duration_weight"; role: "time_weight"; axes: ["domain:period"]; unit: "1"; basis: ""; }, { id: "input:elapsed"; role: "period_count"; axes: ["domain:period"]; unit: "1"; basis: ""; }]; method_slots: [{ id: "slot:cost"; observables: ["observable:base", "observable:alt"]; data_inputs: ["input:probability", "input:duration_weight", "input:elapsed"]; }]; }
referent "case:base": entity { type: "currency.cost"; quantity: { carrier: "currency"; kind: "cost"; unit: "EUR"; value: "0"; sign: "NONE"; basis: "EUR:real:2024"; }; axes: ["domain:scenario", "domain:period"]; }
referent "case:alt": entity { type: "currency.cost"; quantity: { carrier: "currency"; kind: "cost"; unit: "EUR"; value: "0"; sign: "NONE"; basis: "EUR:real:2024"; }; axes: ["domain:scenario", "domain:period"]; }
relation "relation:pair": counterfactual_of("case:alt", "case:base") { authority_refs: ["source:research"]; }
assert "assertion:comparison" REQUIRED SAFETY_GUARANTEE predicate "predicate:comparison" scope "scope:pair" guard true authority ["source:research"] decision OWNER_TBD;
observe "observable:base" from "case:base" { projection: { op: "measure"; ref: "case:base"; indices: [{ op: "var"; name: "s"; }, { op: "var"; name: "t"; }]; }; quantity: { carrier: "currency"; kind: "cost"; unit: "EUR"; value: "0"; sign: "NONE"; basis: "EUR:real:2024"; }; aggregation: "identity"; bindings: [{ var: "s"; domain: "domain:scenario"; }, { var: "t"; domain: "domain:period"; }]; }
observe "observable:alt" from "case:alt" { projection: { op: "measure"; ref: "case:alt"; indices: [{ op: "var"; name: "s"; }, { op: "var"; name: "t"; }]; }; quantity: { carrier: "currency"; kind: "cost"; unit: "EUR"; value: "0"; sign: "NONE"; basis: "EUR:real:2024"; }; aggregation: "identity"; bindings: [{ var: "s"; domain: "domain:scenario"; }, { var: "t"; domain: "domain:period"; }]; }
evidence "evidence:comparison": REQUEST for "assertion:comparison" { status: "NOT_EXECUTED"; oracle: "research:finite-paired"; }
authority "source:research": SOURCE { immutable_ref: "urn:research:synthetic-source"; revision: "1"; decision_state: "OWNER_TBD"; }
predicate "predicate:comparison" = ast({ op: "forall"; var: "s"; domain: { kind: "scenario"; ref: "domain:scenario"; }; body: { op: "forall"; var: "t"; domain: { kind: "time"; ref: "domain:period"; }; body: { op: "compare"; cmp: "le"; lhs: { op: "measure"; ref: "case:alt"; indices: [{ op: "var"; name: "s"; }, { op: "var"; name: "t"; }]; }; rhs: { op: "measure"; ref: "case:base"; indices: [{ op: "var"; name: "s"; }, { op: "var"; name: "t"; }]; }; }; }; });
}
