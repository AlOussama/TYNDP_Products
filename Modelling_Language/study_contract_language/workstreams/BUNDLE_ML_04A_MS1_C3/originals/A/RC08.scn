      };
      "capex": {
        "dims": [];
        "dtype": "float";
        "quantity": {
          "unit": "EUR";
          "carrier": "currency";
          "basis": "EUR:real:2025";
          "sign": "NONE";
          "direction": "NONE";
          "time_basis": "NONE";
        };
        "role": "OBSERVABLE";
        "domain_rule": "ANY_EXACT";
        "source_path": ["synthetic_data", "inputs", "capex"];
      };
      "reported": {
        "dims": [];
        "dtype": "float";
        "quantity": {
          "unit": "EUR";
          "carrier": "currency";
          "basis": "EUR:real:2025";
          "sign": "NONE";
          "direction": "NONE";
          "time_basis": "NONE";
        };
        "role": "OBSERVABLE";
        "domain_rule": "ANY_EXACT";
        "source_path": ["synthetic_data", "observed", "kpi"];
      };
    };
    "expressions": {
      "total": {
        "formula": "sum(sum(opex*dt, over=t)*prob, over=s)*discount+capex";
        "quantity": {
          "unit": "EUR";
          "carrier": "currency";
          "basis": "EUR:real:2025";
          "sign": "NONE";
          "direction": "NONE";
          "time_basis": "NONE";
        };
      };
    };
    "conditions": {
