    };
    "original_obligations": "KPI=sum_s p_s sum_t dt_t*opex_s,t + one capex contribution; apply authorized discount factors at designated times; unique underlying contribution support";
    "original_assumptions": "opex=[20,40] EUR/h, dt=[1/2,3/2] h, one scenario p=1; capex 100 EUR at time zero; discount factor 1 synthetic";
    "original_typed_symbols": "opex EUR/h; duration h; scenario probability dimensionless; capex EUR; price basis EUR:real:2025; year index; discount policy";
    "original_interfaces": "cost inventory, currency/price year, discount, scenario/time weights and selection";
    "variants": [{
        "id": "objective_ledger";
        "projection": "Component cost decomposition";
      }, {
