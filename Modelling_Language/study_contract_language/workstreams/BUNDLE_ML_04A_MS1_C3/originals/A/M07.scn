      "native_checks": [{
          "kind": "native_table";
          "table": ["scenarios"];
          "axis": "s";
          "key": "id";
          "parameters": {
            "weight": {
              "field": "weight";
              "dtype": "float";
            };
            "duration": {
              "field": "duration_h";
              "dtype": "float";
              "quantity": {
                "unit": "h";
                "carrier": "none";
                "basis": "NONE";
                "sign": "NONE";
                "direction": "NONE";
                "time_basis": "NONE";
              };
            };
            "zero_duration": {
              "constant": "0";
              "dtype": "float";
              "quantity": {
                "unit": "h";
                "carrier": "none";
                "basis": "NONE";
                "sign": "NONE";
                "direction": "NONE";
                "time_basis": "NONE";
              };
            };
          };
          "expressions": {
            "weight_sum": "sum(weight, over=s)";
          };
          "conditions": [{
              "name": "probability_present";
              "formula": "weight >= 0";
              "axes": ["s"];
              "code": "SCENARIO_WEIGHT_INVALID";
              "rule": "R12";
              "field": "weight";
            }, {
              "name": "probability_total";
              "formula": "weight_sum == 1";
              "axes": [];
              "code": "SCENARIO_WEIGHT_SUM";
              "rule": "R12";
              "field": "weight";
            }, {
              "name": "duration_positive";
              "formula": "duration > zero_duration";
              "axes": ["s"];
              "code": "TIME_SUPPORT_INVALID";
              "rule": "R07";
              "field": "duration_h";
            }];
        }, {
          "kind": "native_scalar";
          "path": ["economics"];
          "parameters": {
            "rate": {
              "field": "discount_rate";
              "dtype": "float";
            };
            "horizon": {
              "field": "horizon_years";
              "dtype": "int";
            };
            "capex": {
              "field": "capex_eur";
              "dtype": "float";
            };
          };
          "expressions": {

          };
          "conditions": [{
              "name": "rate_valid";
              "formula": "rate >= 0 and rate < 1";
              "axes": [];
              "code": "DISCOUNT_POLICY_INVALID";
              "rule": "R12";
              "field": "discount_rate";
            }, {
              "name": "horizon_valid";
              "formula": "horizon > 0";
              "axes": [];
              "code": "DISCOUNT_POLICY_INVALID";
              "rule": "R12";
              "field": "horizon_years";
            }, {
              "name": "capex_valid";
              "formula": "capex >= 0";
              "axes": [];
              "code": "CAPEX_INVALID";
              "rule": "R12";
              "field": "capex_eur";
            }];
        }, {
          "kind": "native_record_equality";
          "path": ["information", "first_stage"];
          "axis": "s";
          "condition": {
            "name": "same_information_decision";
            "formula": "decision == common";
            "axes": ["s"];
            "code": "STAGE1_INFORMATION_LEAKAGE";
            "rule": "R07";
          };
        }];
    };
    "context_scope": ["research_kind", "study", "authority", "source_ledger", "project", "scenarios", "models", "samples", "observable", "additional_indicators", "comparison", "economics", "evidence", "physical_interfaces", "information", "sensitivities"];
  }
