    };
    "original_obligations": "M1=M0+(inflow-outflow)*dt-loss; mass carrier H2; energy basis only authorized and explicitly converted";
    "original_assumptions": "M0=100 kg; inflow 10 kg/h; outflow 5 kg/h; dt=2 h; loss 1 kg; M1=109 kg";
    "original_typed_symbols": "M: hydrogen inventory kg; inflow/outflow kg/h; duration h; loss kg; optional explicit heating value MWh/kg";
    "original_interfaces": "H2 kg/h port, mass ledger, losses; energy basis if explicitly approved";
    "variants": [{
        "id": "mass";
        "projection": "Inventory directly kg";
      }, {
        "id": "energy";
        "projection": "LHV energy / explicit heating value -> kg";
      }];
    "proof_obligation": "E2-obligation possible; E4 open";
    "domains": {
      "t": {
        "labels": ["t0"];
        "kind": "time";
        "ordered": true;
      };
    };
    "parameters": {
      "initial": {
        "dims": [];
        "dtype": "float";
        "quantity": {
          "unit": "kg";
          "carrier": "hydrogen";
          "basis": "NONE";
          "sign": "NONE";
          "direction": "NONE";
          "time_basis": "NONE";
        };
        "role": "INPUT";
        "domain_rule": "ANY_EXACT";
        "source_path": ["synthetic_data", "inputs", "initial"];
      };
      "inflow": {
        "dims": ["t"];
        "dtype": "float";
        "quantity": {
          "unit": "kg/h";
          "carrier": "hydrogen";
          "basis": "NONE";
          "sign": "NONE";
          "direction": "NONE";
          "time_basis": "NONE";
        };
        "role": "OBSERVABLE";
        "domain_rule": "ANY_EXACT";
        "subject": "port:in";
        "source_path": ["synthetic_data", "inputs", "inflow"];
      };
      "outflow": {
        "dims": ["t"];
        "dtype": "float";
        "quantity": {
          "unit": "kg/h";
          "carrier": "hydrogen";
          "basis": "NONE";
          "sign": "NONE";
          "direction": "NONE";
          "time_basis": "NONE";
        };
        "role": "OBSERVABLE";
        "domain_rule": "ANY_EXACT";
        "subject": "port:out";
        "source_path": ["synthetic_data", "inputs", "outflow"];
      };
      "dt": {
        "dims": ["t"];
        "dtype": "float";
        "quantity": {
          "unit": "h";
          "carrier": "none";
          "basis": "NONE";
          "sign": "NONE";
          "direction": "NONE";
          "time_basis": "NONE";
        };
        "role": "INPUT";
        "domain_rule": "POSITIVE";
        "weight_role": "DURATION_WEIGHT";
        "source_path": ["synthetic_data", "inputs", "dt"];
      };
      "loss": {
        "dims": ["t"];
        "dtype": "float";
        "quantity": {
          "unit": "kg";
          "carrier": "hydrogen";
          "basis": "NONE";
          "sign": "NONE";
          "direction": "NONE";
          "time_basis": "NONE";
        };
        "role": "INPUT";
        "domain_rule": "ANY_EXACT";
        "source_path": ["synthetic_data", "inputs", "loss"];
      };
      "reported": {
        "dims": ["t"];
        "dtype": "float";
        "quantity": {
          "unit": "kg";
          "carrier": "hydrogen";
          "basis": "NONE";
          "sign": "NONE";
          "direction": "NONE";
          "time_basis": "NONE";
        };
        "role": "OBSERVABLE";
        "domain_rule": "ANY_EXACT";
        "source_path": ["synthetic_data", "observed", "final"];
      };
      "zero": {
        "dims": [];
        "dtype": "float";
        "quantity": {
          "unit": "kg";
          "carrier": "hydrogen";
          "basis": "NONE";
          "sign": "NONE";
          "direction": "NONE";
          "time_basis": "NONE";
        };
        "role": "INPUT";
        "domain_rule": "ANY_EXACT";
      };
      "hv": {
        "dims": [];
        "dtype": "float";
        "quantity": {
          "unit": "MWh_H2_LHV/kg";
          "carrier": "conversion";
          "basis": "LHV";
          "sign": "NONE";
          "direction": "NONE";
          "time_basis": "NONE";
        };
        "role": "METHOD_PARAMETER";
        "domain_rule": "POSITIVE";
        "range": {
          "min": "1/1000";
          "max": "100";
        };
        "source_path": ["synthetic_data", "inputs", "heating_value"];
      };
    };
    "expressions": {
      "final": {
        "formula": "initial+(inflow-outflow)*dt-loss";
        "quantity": {
          "unit": "kg";
          "carrier": "hydrogen";
          "basis": "NONE";
          "sign": "NONE";
          "direction": "NONE";
          "time_basis": "NONE";
        };
      };
      "converted_energy": {
        "formula": "final*hv";
        "quantity": {
          "unit": "MWh_H2_LHV";
          "carrier": "hydrogen";
          "basis": "LHV";
          "sign": "NONE";
          "direction": "NONE";
          "time_basis": "NONE";
        };
      };
    };
    "conditions": {
      "mass_ledger": {
        "formula": "final == reported and final >= zero";
        "axes": ["t"];
        "role": "SAFETY_GUARANTEE";
      };
    };
    "components": [{
        "id": "component:H2_store";
        "kind": "storage";
      }];
    "ports": [{
